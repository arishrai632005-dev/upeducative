/* =========================================================
   FOODHUB - MAIN STYLESHEET
   ========================================================= */

:root {
    --primary: #e85d2a;
    --primary-dark: #c94a1d;
    --dark: #181716;
    --dark-light: #292725;
    --text: #292725;
    --muted: #716e69;
    --white: #ffffff;
    --soft: #f8f5f1;
    --border: #e8e4df;
    --success: #258a4b;
    --danger: #d83b3b;
    --shadow: 0 18px 50px rgba(35, 27, 18, 0.09);
    --transition: 0.25s ease;
}

/* ================= RESET ================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: var(--white);
    color: var(--text);
    line-height: 1.6;
}

img {
    max-width: 100%;
    display: block;
}

a {
    color: inherit;
    text-decoration: none;
}

button,
input,
textarea,
select {
    font: inherit;
}

button {
    cursor: pointer;
}

ul {
    list-style: none;
}

/* ================= CONTAINER ================= */

.container {
    width: min(1120px, 92%);
    margin: 0 auto;
}

/* ================= HEADER ================= */

.header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(255, 255, 255, 0.96);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(10px);
}

.nav {
    min-height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
}

/* ================= LOGO ================= */

.logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 1.45rem;
    font-weight: 800;
    letter-spacing: -0.5px;
}

.logo i {
    color: var(--primary);
}

.logo span {
    color: var(--primary);
}

/* ================= NAV LINKS ================= */

.nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
}

.nav-links a {
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 600;
    transition: var(--transition);
}

.nav-links a:hover,
.nav-links a.active {
    color: var(--primary);
}

.cart-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
}

.cart-count {
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50px;
    background: var(--primary);
    color: var(--white);
    font-size: 0.7rem;
}

/* ================= MOBILE MENU ================= */

.menu-toggle {
    display: none;
    border: 0;
    background: transparent;
    color: var(--dark);
    font-size: 1.35rem;
}

/* ================= HERO ================= */

.hero {
    padding: 90px 0;
    background:
        radial-gradient(circle at 85% 20%, #fff0e7 0, transparent 30%),
        linear-gradient(180deg, #fff, #fffaf7);
}

.hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 70px;
}

.hero-content {
    max-width: 650px;
}

.eyebrow {
    color: var(--primary);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 12px;
}

.hero h1 {
    font-size: clamp(3rem, 6vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: -4px;
    margin-bottom: 25px;
}

.hero h1 span {
    color: var(--primary);
}

.hero-text {
    max-width: 570px;
    color: var(--muted);
    font-size: 1.08rem;
    margin-bottom: 30px;
}

/* ================= BUTTONS ================= */

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border: 1px solid transparent;
    border-radius: 12px;
    padding: 13px 20px;
    font-weight: 700;
    transition: var(--transition);
}

.btn-primary {
    background: var(--primary);
    color: var(--white);
}

.btn-primary:hover {
    background: var(--primary-dark);
    transform: translateY(-2px);
}

.btn-outline {
    border-color: var(--border);
    background: var(--white);
    color: var(--dark);
}

.btn-outline:hover {
    border-color: var(--primary);
    color: var(--primary);
}

.btn-dark {
    background: var(--dark);
    color: var(--white);
}

.btn-dark:hover {
    background: #000;
    transform: translateY(-2px);
}

.full-btn {
    width: 100%;
}

/* ================= HERO ACTIONS ================= */

.hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 40px;
}

/* ================= HERO STATS ================= */

.hero-stats {
    display: flex;
    gap: 35px;
}

.hero-stats div {
    display: flex;
    flex-direction: column;
}

.hero-stats strong {
    font-size: 1.25rem;
}

.hero-stats small {
    color: var(--muted);
}

/* ================= HERO CARD ================= */

.hero-card {
    min-height: 450px;
    border-radius: 35px;
    background:
        radial-gradient(circle, #ffb48f 0, #f27642 45%, #d94b1b 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    box-shadow: var(--shadow);
}

.food-orb {
    width: 250px;
    height: 250px;
    border-radius: 50%;
    background: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 7rem;
    color: var(--primary);
    box-shadow: 0 25px 70px rgba(0, 0, 0, 0.18);
}

.floating-tag {
    position: absolute;
    background: var(--white);
    border-radius: 50px;
    padding: 11px 15px;
    font-size: 0.85rem;
    font-weight: 700;
    box-shadow: var(--shadow);
}

.floating-tag i {
    color: var(--primary);
    margin-right: 5px;
}

.tag-one {
    top: 80px;
    left: 25px;
}

.tag-two {
    bottom: 75px;
    right: 25px;
}

/* ================= SECTIONS ================= */

.section {
    padding: 85px 0;
}

.section.soft {
    background: var(--soft);
}

/* ================= SECTION HEADING ================= */

.section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 25px;
    margin-bottom: 35px;
}

.section-heading h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
    letter-spacing: -1.5px;
}

.text-link {
    color: var(--primary);
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

/* ================= CATEGORY GRID ================= */

.category-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
}

.category-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 25px 18px;
    text-align: center;
    transition: var(--transition);
}

.category-card:hover {
    transform: translateY(-5px);
    border-color: var(--primary);
    box-shadow: var(--shadow);
}

.category-card i {
    width: 55px;
    height: 55px;
    margin: 0 auto 15px;
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff0e8;
    color: var(--primary);
    font-size: 1.4rem;
}

.category-card h3 {
    margin-bottom: 4px;
}

.category-card p {
    color: var(--muted);
    font-size: 0.85rem;
}

/* ================= FOOD GRID ================= */

.food-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
}

.food-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 20px;
    overflow: hidden;
    transition: var(--transition);
}

.food-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow);
}

.food-image {
    height: 190px;
    background: linear-gradient(135deg, #fff0e7, #ffd6c2);
    display: flex;
    align-items: center;
    justify-content: center;
}

.food-image i {
    font-size: 5rem;
    color: var(--primary);
}

.food-body {
    padding: 20px;
}

.food-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 15px;
}

.food-top h3 {
    font-size: 1.15rem;
}

.food-body p {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 8px 0 18px;
}

.rating {
    white-space: nowrap;
    color: var(--dark);
    font-size: 0.82rem;
    font-weight: 700;
}

.rating i {
    color: #e6a51f;
}

.food-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.price {
    font-size: 1.2rem;
    font-weight: 800;
}

.add-btn {
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 11px;
    background: var(--dark);
    color: var(--white);
    transition: var(--transition);
}

.add-btn:hover {
    background: var(--primary);
    transform: scale(1.05);
}

/* ================= PROMO ================= */

.promo {
    background: var(--primary);
    color: var(--white);
    border-radius: 25px;
    padding: 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
}

.promo .eyebrow {
    color: rgba(255, 255, 255, 0.75);
}

.promo h2 {
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1.05;
    margin-bottom: 10px;
}

.promo p {
    color: rgba(255, 255, 255, 0.8);
}

/* ================= STEPS ================= */

.steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
}

.steps article {
    padding: 30px;
    border: 1px solid var(--border);
    border-radius: 20px;
    background: var(--white);
    position: relative;
}

.steps article > span {
    position: absolute;
    top: 20px;
    right: 22px;
    color: #d7d2cc;
    font-weight: 800;
}

.steps article i {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff0e8;
    color: var(--primary);
    border-radius: 14px;
    margin-bottom: 20px;
}

.steps h3 {
    margin-bottom: 8px;
}

.steps p {
    color: var(--muted);
}

/* ================= REVIEWS ================= */

.review-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
}

.review {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 28px;
}

.stars {
    color: #e6a51f;
    letter-spacing: 2px;
    margin-bottom: 15px;
}

.review p {
    color: var(--muted);
    margin-bottom: 20px;
}

.review strong,
.review small {
    display: block;
}

.review small {
    color: var(--muted);
}

/* ================= PAGE BANNER ================= */

.page-banner {
    padding: 75px 0;
    background:
        radial-gradient(circle at 85% 30%, #ffe6d8, transparent 35%),
        var(--soft);
}

.page-banner h1 {
    max-width: 800px;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1;
    letter-spacing: -3px;
    margin-bottom: 18px;
}

.page-banner > .container > p:last-child {
    max-width: 650px;
    color: var(--muted);
    font-size: 1.05rem;
}

/* ================= TWO COLUMN ================= */

.two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 70px;
}

.two-col h2 {
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.05;
    margin-bottom: 20px;
}

.two-col p {
    color: var(--muted);
    margin-bottom: 18px;
}

/* ================= ABOUT PANEL ================= */

.about-panel {
    padding: 45px;
    background: var(--dark);
    color: var(--white);
    border-radius: 25px;
    box-shadow: var(--shadow);
}

.about-icon {
    width: 65px;
    height: 65px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 17px;
    background: var(--primary);
    font-size: 1.6rem;
    margin-bottom: 25px;
}

.about-panel h3 {
    font-size: 1.8rem;
    margin-bottom: 12px;
}

.about-panel p {
    color: #b9b5b0;
}

.about-mini-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
    margin-top: 30px;
    padding-top: 25px;
    border-top: 1px solid #3b3937;
}

.about-mini-stats div {
    display: flex;
    flex-direction: column;
}

.about-mini-stats strong {
    font-size: 1.4rem;
}

.about-mini-stats span {
    color: #aaa49f;
    font-size: 0.8rem;
}

/* ================= VALUES ================= */

.value-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.value-card {
    padding: 25px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--white);
}

.value-icon {
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 13px;
    background: #fff0e8;
    color: var(--primary);
    margin-bottom: 18px;
}

.value-card h3 {
    margin-bottom: 8px;
}

.value-card p {
    color: var(--muted);
    font-size: 0.9rem;
}

/* ================= STATS ================= */

.stats-banner {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--border);
    border-radius: 22px;
    overflow: hidden;
}

.stats-banner div {
    padding: 30px 20px;
    text-align: center;
    background: var(--white);
    border-right: 1px solid var(--border);
}

.stats-banner div:last-child {
    border-right: 0;
}

.stats-banner i {
    color: var(--primary);
    display: block;
    font-size: 1.3rem;
    margin-bottom: 10px;
}

.stats-banner strong,
.stats-banner span {
    display: block;
}

.stats-banner strong {
    font-size: 1.5rem;
}

.stats-banner span {
    color: var(--muted);
    font-size: 0.85rem;
}

/* ================= CONTACT ================= */

.contact-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 60px;
    align-items: start;
}

.contact-info h2 {
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.05;
    margin-bottom: 20px;
}

.contact-info > p {
    color: var(--muted);
    margin-bottom: 30px;
}

.contact-list {
    display: grid;
    gap: 20px;
}

.contact-item {
    display: flex;
    align-items: center;
    gap: 15px;
}

.contact-icon {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 13px;
    background: #fff0e8;
    color: var(--primary);
    font-size: 1.1rem;
}

.contact-item h3 {
    margin-bottom: 3px;
}

.contact-item p {
    color: var(--muted);
    font-size: 0.9rem;
}

/* ================= FORMS ================= */

.form-card {
    padding: 35px;
    border: 1px solid var(--border);
    border-radius: 22px;
    background: var(--white);
    box-shadow: var(--shadow);
}

.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
}

.form-group {
    margin-bottom: 18px;
}

.form-group.full {
    grid-column: 1 / -1;
}

.form-group label {
    display: block;
    margin-bottom: 7px;
    font-size: 0.9rem;
    font-weight: 700;
}

.form-group input,
.form-group textarea,
.form-group select {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 13px 14px;
    outline: none;
    background: var(--white);
    color: var(--text);
}

.form-group textarea {
    min-height: 140px;
    resize: vertical;
}

.form-group input:focus,
.form-group textarea:focus,
.form-group select:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(232, 93, 42, 0.1);
}

/* ================= FAQ ================= */

.faq-list {
    display: grid;
    gap: 12px;
}

.faq-item {
    border: 1px solid var(--border);
    border-radius: 15px;
    background: var(--white);
    overflow: hidden;
}

.faq-question {
    width: 100%;
    border: 0;
    background: transparent;
    padding: 18px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    text-align: left;
    font-weight: 700;
    color: var(--text);
}

.faq-question i {
    color: var(--primary);
    transition: var(--transition);
}

.faq-answer {
    display: none;
    padding: 0 20px 18px;
    color: var(--muted);
}

.faq-item.open .faq-answer {
    display: block;
}

.faq-item.open .faq-question i {
    transform: rotate(180deg);
}

/* ================= EMPTY STATE ================= */

.empty-state {
    text-align: center;
    padding: 70px 20px;
    border: 1px dashed var(--border);
    border-radius: 20px;
    background: var(--soft);
}

.empty-state i {
    font-size: 3rem;
    color: var(--primary);
    margin-bottom: 18px;
}

.empty-state h2 {
    margin-bottom: 8px;
}

.empty-state p {
    color: var(--muted);
    margin-bottom: 20px;
}

/* ================= FOOTER ================= */

.footer {
    background: var(--dark);
    color: var(--white);
    padding: 65px 0 25px;
}

.footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 35px;
}

.footer .logo {
    color: var(--white);
    margin-bottom: 15px;
}

.footer .logo span {
    color: var(--primary);
}

.footer p {
    color: #aaa49f;
    font-size: 0.9rem;
}

.footer h3 {
    margin-bottom: 15px;
    font-size: 1rem;
}

.footer a {
    color: #aaa49f;
    font-size: 0.9rem;
}

.footer a:hover {
    color: var(--white);
}

.footer-grid > div > a:not(.logo):hover {
    color: var(--primary);
}

.footer-links {
    display: grid;
    gap: 9px;
}

.footer-social {
    display: flex;
    gap: 10px;
    margin-top: 18px;
}

.footer-social a {
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: #292725;
    color: var(--white);
}

.footer-social a:hover {
    background: var(--primary);
}

.footer-bottom {
    margin-top: 45px;
    padding-top: 20px;
    border-top: 1px solid #34312f;
    display: flex;
    justify-content: space-between;
    gap: 15px;
    color: #88827d;
    font-size: 0.8rem;
}

/* ================= TOAST ================= */

.toast {
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 2000;
    background: var(--dark);
    color: var(--white);
    padding: 13px 18px;
    border-radius: 12px;
    box-shadow: var(--shadow);
    opacity: 0;
    transform: translateY(15px);
    pointer-events: none;
    transition: var(--transition);
}

.toast.show {
    opacity: 1;
    transform: translateY(0);
}

/* ================= UTILITY ================= */

.hidden {
    display: none !important;
}
